<%- include('partials/header') %>

<div class="row-between">
  <h1>Products</h1>
  <a class="btn" href="/products/new">+ Register Product</a>
</div>

<table class="data-table">
  <thead>
    <tr>
      <th>Product</th>
      <th>Brand</th>
      <th>Serial No.</th>
      <th>Owner</th>
      <th>Purchase Date</th>
      <th>Warranty Expiry</th>
      <th>Status</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => {
      const today = new Date();
      const expiry = new Date(p.warrantyExpiry);
      const active = expiry >= today;
    %>
      <tr>
        <td><a href="/products/<%= p.id %>"><%= p.productName %></a></td>
        <td><%= p.brand || '-' %></td>
        <td><%= p.serialNumber %></td>
        <td><%= p.Customer ? p.Customer.name : '-' %></td>
        <td><%= p.purchaseDate %></td>
        <td><%= p.warrantyExpiry %></td>
        <td>
          <span class="badge <%= active ? 'badge-active' : 'badge-expired' %>">
            <%= active ? 'Under Warranty' : 'Expired' %>
          </span>
        </td>
        <td>
          <form action="/products/<%= p.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this product and its service records?');">
            <button class="btn-small btn-danger" type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (products.length === 0) { %>
      <tr><td colspan="8" class="empty">No products registered yet.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
